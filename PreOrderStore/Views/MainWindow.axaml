<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PreOrderStore.ViewModels"
        xmlns:views="using:PreOrderStore.Views"
        xmlns:domain="using:PreOrderStore.Domain"
        xmlns:svg="using:Avalonia.Svg"
        x:Class="PreOrderStore.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PreOrder Store · Предзаказы новинок"
        Width="1440" Height="920" MinWidth="1120" MinHeight="720"
        Background="{DynamicResource C_F4F5F1}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="C_173F2C" Color="#173F2C" />
      <SolidColorBrush x:Key="C_1B523A" Color="#1B523A" />
      <SolidColorBrush x:Key="C_202720" Color="#202720" />
      <SolidColorBrush x:Key="C_234B37" Color="#234B37" />
      <SolidColorBrush x:Key="C_244A35" Color="#244A35" />
      <SolidColorBrush x:Key="C_246247" Color="#246247" />
      <SolidColorBrush x:Key="C_26332A" Color="#26332A" />
      <SolidColorBrush x:Key="C_365C43" Color="#365C43" />
      <SolidColorBrush x:Key="C_4E5C51" Color="#4E5C51" />
      <SolidColorBrush x:Key="C_526C59" Color="#526C59" />
      <SolidColorBrush x:Key="C_53675A" Color="#53675A" />
      <SolidColorBrush x:Key="C_54715E" Color="#54715E" />
      <SolidColorBrush x:Key="C_59655C" Color="#59655C" />
      <SolidColorBrush x:Key="C_66736A" Color="#66736A" />
      <SolidColorBrush x:Key="C_68746B" Color="#68746B" />
      <SolidColorBrush x:Key="C_695A3D" Color="#695A3D" />
      <SolidColorBrush x:Key="C_6D786F" Color="#6D786F" />
      <SolidColorBrush x:Key="C_6E7B71" Color="#6E7B71" />
      <SolidColorBrush x:Key="C_6F6655" Color="#6F6655" />
      <SolidColorBrush x:Key="C_6F7E72" Color="#6F7E72" />
      <SolidColorBrush x:Key="C_716958" Color="#716958" />
      <SolidColorBrush x:Key="C_718076" Color="#718076" />
      <SolidColorBrush x:Key="C_728078" Color="#728078" />
      <SolidColorBrush x:Key="C_737F75" Color="#737F75" />
      <SolidColorBrush x:Key="C_738077" Color="#738077" />
      <SolidColorBrush x:Key="C_748077" Color="#748077" />
      <SolidColorBrush x:Key="C_758178" Color="#758178" />
      <SolidColorBrush x:Key="C_778279" Color="#778279" />
      <SolidColorBrush x:Key="C_78837A" Color="#78837A" />
      <SolidColorBrush x:Key="C_78847A" Color="#78847A" />
      <SolidColorBrush x:Key="C_7A857C" Color="#7A857C" />
      <SolidColorBrush x:Key="C_859086" Color="#859086" />
      <SolidColorBrush x:Key="C_879188" Color="#879188" />
      <SolidColorBrush x:Key="C_9A493F" Color="#9A493F" />
      <SolidColorBrush x:Key="C_9EAF9F" Color="#9EAF9F" />
      <SolidColorBrush x:Key="C_A7B7AA" Color="#A7B7AA" />
      <SolidColorBrush x:Key="C_D8E4DA" Color="#D8E4DA" />
      <SolidColorBrush x:Key="C_D9E0D9" Color="#D9E0D9" />
      <SolidColorBrush x:Key="C_DCE2DC" Color="#DCE2DC" />
      <SolidColorBrush x:Key="C_DCE8DE" Color="#DCE8DE" />
      <SolidColorBrush x:Key="C_DDE3DD" Color="#DDE3DD" />
      <SolidColorBrush x:Key="C_E0E5DF" Color="#E0E5DF" />
      <SolidColorBrush x:Key="C_E1E6E0" Color="#E1E6E0" />
      <SolidColorBrush x:Key="C_E4EFE7" Color="#E4EFE7" />
      <SolidColorBrush x:Key="C_E8EFE9" Color="#E8EFE9" />
      <SolidColorBrush x:Key="C_E9E4D9" Color="#E9E4D9" />
      <SolidColorBrush x:Key="C_E9EDE8" Color="#E9EDE8" />
      <SolidColorBrush x:Key="C_ECEFEA" Color="#ECEFEA" />
      <SolidColorBrush x:Key="C_EDF2EC" Color="#EDF2EC" />
      <SolidColorBrush x:Key="C_F1ECE2" Color="#F1ECE2" />
      <SolidColorBrush x:Key="C_F2F4F0" Color="#F2F4F0" />
      <SolidColorBrush x:Key="C_F2F6F2" Color="#F2F6F2" />
      <SolidColorBrush x:Key="C_F3F5F1" Color="#F3F5F1" />
      <SolidColorBrush x:Key="C_F4F5F1" Color="#F4F5F1" />
      <SolidColorBrush x:Key="C_F5F3ED" Color="#F5F3ED" />
      <SolidColorBrush x:Key="C_F6F8F5" Color="#F6F8F5" />
      <SolidColorBrush x:Key="C_F7F9F6" Color="#F7F9F6" />
      <SolidColorBrush x:Key="C_FAFBF9" Color="#FAFBF9" />
      <SolidColorBrush x:Key="C_FFFFFF" Color="#FFFFFF" />
      <DataTemplate x:Key="ProductCardTemplate" x:DataType="domain:Product">
        <Border Classes="surface product-card" MaxWidth="340" Margin="0,0,0,14" Padding="12" Tag="{Binding}" Tapped="OnProductCardTapped" Cursor="Hand">
          <StackPanel Spacing="9">
            <Grid Height="124">
              <Border Background="{DynamicResource C_F2F4F0}" CornerRadius="10" ClipToBounds="True">
                <Grid>
                  <svg:Svg Path="/Assets/Icons/catalog.svg" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsLocalProduct}" />
                  <svg:Svg Path="{Binding ImageAssetPath}" Stretch="Uniform" IsVisible="{Binding IsLocalProduct}" Margin="18" />
                  <views:RemoteImage Url="{Binding ImageAssetPath}" Stretch="UniformToFill" IsVisible="{Binding !IsLocalProduct}" />
                </Grid>
              </Border>
              <Button Classes="photo-tap" Tag="{Binding}" Click="OnOpenProductClick" ToolTip.Tip="Открыть товар" />
              <Button Classes="favorite-action" Classes.liked="{Binding IsFavorite}" Tag="{Binding}" Click="OnToggleFavoriteClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="{Binding FavoriteButtonLabel}">
                <svg:Svg Path="{Binding FavoriteIconPath}" Width="19" Height="19" />
              </Button>
              <Border Classes="release-badge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                <TextBlock Text="{Binding ReleaseStateDisplay}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource C_365C43}" />
              </Border>
            </Grid>
            <TextBlock Text="{Binding CategoryDisplay}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource C_7A857C}" />
            <Button Classes="link" HorizontalContentAlignment="Left" Padding="0" Tag="{Binding}" Click="OnOpenProductClick" ToolTip.Tip="Открыть подробную страницу товара">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42" />
                <TextBlock Text="Подробнее о товаре →" FontSize="10" Foreground="{DynamicResource C_526C59}" />
              </StackPanel>
            </Button>
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,2,0,0">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding PriceDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource C_234B37}" />
                <TextBlock Text="{Binding ArrivalDisplay}" FontSize="9.5" Foreground="{DynamicResource C_78847A}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="primary" Tag="{Binding}" Click="OnToggleCartClick" IsEnabled="{Binding CartActionEnabled}" Padding="9,7" ToolTip.Tip="{Binding CartActionTooltip}">
                <svg:Svg Path="{Binding CartActionIconPath}" Width="17" Height="17" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="views|RemoteImage">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.32" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource C_202720}" />
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource C_59655C}" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource C_F7F9F6}" />
      <Setter Property="Foreground" Value="{DynamicResource C_244A35}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource C_DCE8DE}" />
      <Setter Property="Foreground" Value="{DynamicResource C_244A35}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource C_246247}" />
      <Setter Property="Foreground" Value="{DynamicResource C_FFFFFF}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_246247}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="15,10" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource C_1B523A}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_1B523A}" />
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource C_FFFFFF}" />
      <Setter Property="Foreground" Value="{DynamicResource C_26332A}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_D9E0D9}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="13,9" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource C_F2F6F2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_A7B7AA}" />
    </Style>
    <Style Selector="Button.bank-option">
      <Setter Property="Background" Value="{DynamicResource C_FFFFFF}" />
      <Setter Property="Foreground" Value="{DynamicResource C_202720}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_D9E0D9}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.16" /><BrushTransition Property="BorderBrush" Duration="0:0:0.16" /></Transitions></Setter>
    </Style>
    <Style Selector="Button.bank-option:pointerover">
      <Setter Property="Background" Value="{DynamicResource C_F2F6F2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_246247}" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Background" Value="{DynamicResource C_F6F8F5}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_E1E6E0}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Button.icon-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource C_E8EFE9}" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource C_246247}" />
      <Setter Property="Padding" Value="4,7" />
    </Style>
    <Style Selector="Button.link:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource C_173F2C}" />
      <Setter Property="Opacity" Value="0.78" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource C_FAFBF9}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_DDE3DD}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource C_FFFFFF}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_DDE3DD}" />
    </Style>
    <Style Selector="Border.product-card">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.17" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.17" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.product-card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource C_9EAF9F}" />
      <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>
    <Style Selector="Border.cart-count">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.17" /></Transitions></Setter>
    </Style>
    <Style Selector="Border.cart-count.pulse">
      <Setter Property="RenderTransform" Value="scale(1.18)" />
    </Style>
    <Style Selector="Border.cart-row">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.cart-row.entering">
      <Setter Property="Opacity" Value="0.08" />
      <Setter Property="RenderTransform" Value="translateY(12px)" />
    </Style>
    <Style Selector="Border.cart-row.removing">
      <Setter Property="Opacity" Value="0.04" />
      <Setter Property="RenderTransform" Value="translateY(-7px)" />
    </Style>
    <Style Selector="Button.favorite-action">
      <Setter Property="Background" Value="{DynamicResource C_FFFFFF}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_DDE3DD}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" /><BrushTransition Property="Background" Duration="0:0:0.16" /></Transitions></Setter>
    </Style>
    <Style Selector="Button.favorite-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource C_F2F6F2}" />
      <Setter Property="RenderTransform" Value="scale(1.09)" />
    </Style>
    <Style Selector="Button.favorite-action.liked">
      <Setter Property="Background" Value="{DynamicResource C_E4EFE7}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_A7B7AA}" />
    </Style>
    <Style Selector="Button.photo-tap">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Grid.page-content">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Grid.page-content.page-entering">
      <Setter Property="Opacity" Value="0.05" />
      <Setter Property="RenderTransform" Value="translateY(10px)" />
    </Style>
    <Style Selector="TextBlock.form-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource C_4E5C51}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource C_728078}" />
    </Style>
    <Style Selector="TextBlock.notice-error">
      <Setter Property="Foreground" Value="{DynamicResource C_9A493F}" />
    </Style>
    <Style Selector="Border.surface">
      <Setter Property="Background" Value="{DynamicResource C_FFFFFF}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_E0E5DF}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.release-badge">
      <Setter Property="Background" Value="{DynamicResource C_E4EFE7}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
  </Window.Styles>

  <Grid Background="{DynamicResource C_F4F5F1}">
    <!-- Store shell -->
    <Grid IsVisible="{Binding IsAppVisible}" IsEnabled="{Binding !IsPaymentProcessing}" ColumnDefinitions="232,*">
      <Border Grid.Column="0" Background="{DynamicResource C_E9EDE8}" BorderBrush="{DynamicResource C_DCE2DC}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="17,22,15,16">
          <Grid ColumnDefinitions="42,*" ColumnSpacing="10" VerticalAlignment="Center">
            <Border Background="{DynamicResource C_246247}" CornerRadius="11" Width="42" Height="42">
              <svg:Svg Path="/Assets/Icons/mark.svg" Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="PreOrder" FontSize="17" FontWeight="SemiBold" LetterSpacing="-0.25" />
              <TextBlock Text="STORE · НОВИНКИ" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource C_6E7B71}" LetterSpacing="1.1" />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="1" Margin="0,36,0,0" Spacing="5">
            <TextBlock Text="МАГАЗИН" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource C_879188}" LetterSpacing="1.2" Margin="12,0,0,8" />
            <Button Classes="nav" Classes.active="{Binding IsCatalogSelected}" Command="{Binding NavigateCommand}" CommandParameter="Каталог">
              <Grid ColumnDefinitions="28,*" ColumnSpacing="9">
                <svg:Svg Path="/Assets/Icons/catalog.svg" Width="19" Height="19" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Каталог" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="CartNavigationButton" Classes="nav" Classes.active="{Binding IsCartSelected}" Command="{Binding NavigateCommand}" CommandParameter="Корзина">
              <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="9">
                <svg:Svg Path="/Assets/Icons/bag.svg" Width="19" Height="19" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Корзина" VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="cart-count" Classes.pulse="{Binding CartCountPulse}" Background="{DynamicResource C_DCE8DE}" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CartCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource C_365C43}" />
                </Border>
              </Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsFavoritesSelected}" Command="{Binding NavigateCommand}" CommandParameter="Избранное">
              <Grid ColumnDefinitions="28,*" ColumnSpacing="9">
                <svg:Svg Path="/Assets/Icons/heart-filled.svg" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Избранное" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="nav" IsVisible="{Binding CanManageProducts}" Command="{Binding OpenAddProductCommand}">
              <Grid ColumnDefinitions="28,*" ColumnSpacing="9">
                <svg:Svg Path="/Assets/Icons/plus.svg" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Добавить товар" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="nav" IsVisible="{Binding IsAuthenticated}" Classes.active="{Binding IsOrdersSelected}" Command="{Binding NavigateCommand}" CommandParameter="Заказы">
              <Grid ColumnDefinitions="28,*" ColumnSpacing="9">
                <svg:Svg Path="/Assets/Icons/receipt.svg" Width="19" Height="19" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Мои покупки" VerticalAlignment="Center" />
              </Grid>
            </Button>

          </StackPanel>

          <Border Grid.Row="2" Background="{DynamicResource C_F3F5F1}" CornerRadius="12" Padding="11">
            <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="8">
              <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource C_D8E4DA}">
                <svg:Svg Path="/Assets/Icons/user.svg" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding CurrentUserName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding HasAccountText}" FontSize="9" Foreground="{DynamicResource C_778279}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon-button" Command="{Binding SignOutCommand}" ToolTip.Tip="Выйти" IsVisible="{Binding IsSignOutButtonVisible}">
                <svg:Svg Path="/Assets/Icons/logout.svg" Width="17" Height="17" />
              </Button>
              <Button Grid.Column="2" Classes="icon-button" Command="{Binding OpenAccountCommand}" ToolTip.Tip="Войти или создать профиль" IsVisible="{Binding IsAccountButtonVisible}">
                <svg:Svg Path="/Assets/Icons/user.svg" Width="17" Height="17" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="9" Margin="32,22,32,18">
          <StackPanel VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="{Binding CurrentSection}" FontSize="24" FontWeight="SemiBold" LetterSpacing="-0.4" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleThemeCommand}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6"><svg:Svg Path="{Binding ThemeButtonIcon}" Width="16" Height="16"/><TextBlock Text="{Binding ThemeButtonText}" FontSize="11"/></StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="secondary" Command="{Binding OpenAccountCommand}" Content="Войти" VerticalAlignment="Center" IsVisible="{Binding IsAccountButtonVisible}"/>
          <Button Grid.Column="3" Classes="secondary" Command="{Binding RefreshCatalogCommand}" VerticalAlignment="Center" IsEnabled="{Binding !IsBusy}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <svg:Svg Path="/Assets/Icons/refresh.svg" Width="17" Height="17" />
              <TextBlock Text="Обновить товары" FontSize="12" />
            </StackPanel>
          </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="32,0,32,18">
          <!-- Release catalogue -->
          <Grid IsVisible="{Binding IsCatalogVisible}" ColumnDefinitions="*,292" ColumnSpacing="18">
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding CatalogSectionTitle}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource C_FFFFFF}" BorderBrush="{DynamicResource C_E1E6E0}" BorderThickness="1" CornerRadius="8" Padding="9,6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding FilteredProductsCountText}" FontSize="10" Foreground="{DynamicResource C_68746B}" />
                </Border>
              </Grid>

              <Border Grid.Row="1" Background="{DynamicResource C_FFFFFF}" BorderBrush="{DynamicResource C_DDE3DD}" BorderThickness="1" CornerRadius="9" Padding="10,0">
                <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                  <svg:Svg Path="/Assets/Icons/search.svg" Width="18" Height="18" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" PlaceholderText="Поиск товаров по названию" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" MinHeight="40" Padding="2,8" />
                </Grid>
              </Border>

              <Grid Grid.Row="2" ColumnDefinitions="1.15*,1.1*,1.65*" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailabilityOptions}" SelectedItem="{Binding SelectedAvailability}" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" />
              </Grid>

              <Grid Grid.Row="3" RowDefinitions="*,Auto" RowSpacing="8">
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding ProductRows}">
                    <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogProductRow">
                      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <ContentControl Content="{Binding First}" ContentTemplate="{StaticResource ProductCardTemplate}" />
                        <ContentControl Grid.Column="1" Content="{Binding Second}" ContentTemplate="{StaticResource ProductCardTemplate}" IsVisible="{Binding HasSecond}" />
                        <ContentControl Grid.Column="2" Content="{Binding Third}" ContentTemplate="{StaticResource ProductCardTemplate}" IsVisible="{Binding HasThird}" />
                        <ContentControl Grid.Column="3" Content="{Binding Fourth}" ContentTemplate="{StaticResource ProductCardTemplate}" IsVisible="{Binding HasFourth}" />
                      </Grid>
                    </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="1" Classes="secondary" Command="{Binding LoadMoreProductsCommand}"
                        IsVisible="{Binding CanLoadMoreProducts}" HorizontalAlignment="Center">
                  <TextBlock Text="Показать ещё товары" />
                </Button>
                <StackPanel IsVisible="{Binding HasNoProducts}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="300">
                  <svg:Svg Path="/Assets/Icons/search.svg" Width="34" Height="34" HorizontalAlignment="Center" />
                  <TextBlock Text="Ничего не найдено" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="Измените запрос или параметры фильтра." FontSize="11" Foreground="{DynamicResource C_758178}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
              </Grid>
            </Grid>

            <!-- Product detail -->
            <Border Grid.Column="1" Classes="surface" Padding="15">
              <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelectedProduct}">
                  <StackPanel Spacing="13">
                    <Grid Height="166">
                      <Border Background="{DynamicResource C_F2F4F0}" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                          <svg:Svg Path="/Assets/Icons/catalog.svg" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !SelectedProduct.IsLocalProduct}" />
                          <svg:Svg Path="{Binding SelectedProduct.ImageAssetPath}" Stretch="Uniform" IsVisible="{Binding SelectedProduct.IsLocalProduct}" Margin="22" />
                        </Grid>
                      </Border>
                      <Border Classes="release-badge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9">
                        <TextBlock Text="{Binding SelectedProduct.ReleaseStateDisplay}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource C_365C43}" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding SelectedProduct.CategoryDisplay}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource C_7A857C}" />
                    <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedPriceText}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource C_234B37}" />
                    <Grid ColumnDefinitions="22,*" ColumnSpacing="7">
                      <svg:Svg Path="/Assets/Icons/calendar.svg" Width="17" Height="17" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding SelectedArrivalText}" FontSize="11" Foreground="{DynamicResource C_68746B}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding SelectedAvailabilityText}" FontSize="11" Foreground="{DynamicResource C_53675A}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedProduct.Description}" FontSize="11" Foreground="{DynamicResource C_6D786F}" TextWrapping="Wrap" LineHeight="16" />
                    <Border Background="{DynamicResource C_F5F3ED}" BorderBrush="{DynamicResource C_E9E4D9}" BorderThickness="1" CornerRadius="9" Padding="10">
                      <Grid ColumnDefinitions="22,*" ColumnSpacing="6">
                        <svg:Svg Path="/Assets/Icons/info.svg" Width="16" Height="16" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="Цены и наличие указаны для ориентира и требуют подтверждения перед оформлением." FontSize="9.5" Foreground="{DynamicResource C_6F6655}" TextWrapping="Wrap" LineHeight="14" />
                      </Grid>
                    </Border>
                    <Button Classes="primary" Content="Добавить в корзину" Tag="{Binding SelectedProduct}" Click="OnAddToCartClick" IsEnabled="{Binding SelectedProduct.IsAvailable}" HorizontalContentAlignment="Center" />
                  </StackPanel>
                </ScrollViewer>
                <StackPanel IsVisible="{Binding HasNoSelectedProduct}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="11" MaxWidth="210">
                  <svg:Svg Path="/Assets/Icons/catalog.svg" Width="31" Height="31" HorizontalAlignment="Center" />
                  <TextBlock Text="Выберите товар" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="Здесь появятся описание и доступные действия." FontSize="10.5" Foreground="{DynamicResource C_778279}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- Persistent local cart -->
          <Grid IsVisible="{Binding IsCartVisible}" RowDefinitions="Auto,*,Auto" RowSpacing="13">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="Ваша корзина" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Изменяйте количество или удаляйте товары прямо здесь" FontSize="11" Foreground="{DynamicResource C_778279}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary" Content="Очистить корзину" Command="{Binding ClearCartCommand}" IsEnabled="{Binding CanClearCart}" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CartItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="domain:CartItem">
                      <Border Classes="surface cart-row" Classes.entering="{Binding IsEntering}" Classes.removing="{Binding IsRemoving}" Margin="0,0,0,10" Padding="12">
                        <Grid ColumnDefinitions="100,*,Auto,Auto,Auto" ColumnSpacing="12">
                          <Border Background="{DynamicResource C_F2F4F0}" CornerRadius="9" ClipToBounds="True" Height="74">
                            <Grid>
                              <svg:Svg Path="/Assets/Icons/catalog.svg" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Product.IsLocalProduct}" />
                              <svg:Svg Path="{Binding Product.ImageAssetPath}" Stretch="Uniform" IsVisible="{Binding Product.IsLocalProduct}" Margin="7" />
                              <views:RemoteImage Url="{Binding Product.ImageAssetPath}" Stretch="UniformToFill" IsVisible="{Binding !Product.IsLocalProduct}" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding Product.Name}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Product.PriceDisplay}" FontSize="11" Foreground="{DynamicResource C_738077}" />
                            <TextBlock Text="{Binding Product.ArrivalDisplay}" FontSize="10" Foreground="{DynamicResource C_879188}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="icon-button" Tag="{Binding}" Click="OnDecrementCartClick">
                              <svg:Svg Path="/Assets/Icons/minus.svg" Width="15" Height="15" />
                            </Button>
                            <TextBlock Text="{Binding Quantity}" MinWidth="18" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                            <Button Classes="icon-button" Tag="{Binding Product}" Click="OnAddToCartClick" IsEnabled="{Binding Product.IsAvailable}">
                              <svg:Svg Path="/Assets/Icons/plus.svg" Width="15" Height="15" />
                            </Button>
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="{Binding LineTotalDisplay}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="110" TextAlignment="Right" />
                          <Button Grid.Column="4" Classes="icon-button" Tag="{Binding}" Click="OnDeleteCartItemClick" ToolTip.Tip="Удалить товар целиком" VerticalAlignment="Center">
                            <svg:Svg Path="/Assets/Icons/trash.svg" Width="15" Height="15" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel IsVisible="{Binding HasNoCartItems}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <svg:Svg Path="/Assets/Icons/empty-bag.svg" Width="52" Height="52" HorizontalAlignment="Center" />
                <TextBlock Text="Корзина пока пуста" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Добавьте интересующие новинки из каталога." FontSize="11" Foreground="{DynamicResource C_778279}" HorizontalAlignment="Center" />
                <Button Classes="secondary" Content="Перейти в каталог" Command="{Binding NavigateCommand}" CommandParameter="Каталог" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
            <Border Grid.Row="2" Classes="surface" Padding="16">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="22">
                <StackPanel VerticalAlignment="Center" Spacing="3">
                  <TextBlock Text="Демо-оплата через Demo Bank" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Text="Симуляция: реальные деньги не списываются." FontSize="10" Foreground="{DynamicResource C_78837A}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                  <TextBlock Text="Итого" FontSize="10" Foreground="{DynamicResource C_778279}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding CartTotalText}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource C_234B37}" HorizontalAlignment="Right" />
                </StackPanel>
                <Button Grid.Column="2" Classes="primary" Content="Перейти к покупке" Command="{Binding CheckoutCommand}" IsEnabled="{Binding CanCheckout}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>

          <!-- Payment choice launches the separate Demo Bank application. -->
          <Grid IsVisible="{Binding IsPaymentVisible}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <Border Classes="surface" Padding="28">
              <StackPanel Spacing="15">
                <TextBlock Text="Выберите способ оплаты" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Доступен один способ — Demo Bank. Нажмите на него, чтобы открыть отдельное приложение и подтвердить демо-платёж." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource C_6D786F}" LineHeight="18"/>
                <Button Classes="bank-option" Command="{Binding PayWithDemoBankCommand}" IsEnabled="{Binding CanPayWithDemoBank}">
                  <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12">
                    <Border Background="{DynamicResource C_E4EFE7}" CornerRadius="10" Width="48" Height="48" VerticalAlignment="Center">
                      <svg:Svg Path="/Assets/Icons/demo-bank.svg" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                      <TextBlock Text="Demo Bank" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="Отдельное приложение · только симуляция" FontSize="10" Foreground="{DynamicResource C_778279}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="Открыть →" FontSize="11" Foreground="{DynamicResource C_246247}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                  <StackPanel><TextBlock Text="Товаров в корзине" FontSize="11" Foreground="{DynamicResource C_778279}"/><TextBlock Text="{Binding CartCount, StringFormat='{}{0} шт.'}" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="Сумма покупки" FontSize="11" Foreground="{DynamicResource C_778279}" HorizontalAlignment="Right"/><TextBlock Text="{Binding PaymentTotalText}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource C_234B37}" HorizontalAlignment="Right"/></StackPanel>
                </Grid>
                <Border Background="{DynamicResource C_F5F3ED}" BorderBrush="{DynamicResource C_E9E4D9}" BorderThickness="1" CornerRadius="8" Padding="10">
                  <TextBlock Text="Демо Bank не обращается к банковским счетам и не переводит деньги. Подтверждение будет записано как демонстрационная оплата." FontSize="10" Foreground="{DynamicResource C_6F6655}" TextWrapping="Wrap" LineHeight="15" />
                </Border>
                <TextBlock Text="Ожидаем ответ от Demo Bank…" IsVisible="{Binding IsPaymentProcessing}" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource C_526C59}" />
                <Button Classes="secondary" Content="Назад в корзину" Command="{Binding CancelPaymentCommand}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Customer-specific preorder history -->
          <Grid IsVisible="{Binding IsOrdersVisible}" RowDefinitions="Auto,*" RowSpacing="13">
            <StackPanel Spacing="3">
                  <TextBlock Text="Мои покупки" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="Заказы сохранены в локальной базе этого устройства" FontSize="11" Foreground="{DynamicResource C_778279}" />
            </StackPanel>
            <Grid Grid.Row="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PreOrders}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="domain:PreOrder">
                      <Border Classes="surface" Margin="0,0,0,10" Padding="15">
                        <Grid ColumnDefinitions="74,*,140,130,Auto" ColumnSpacing="15">
                          <Border Background="{DynamicResource C_F2F4F0}" CornerRadius="9" ClipToBounds="True" Height="62">
                            <svg:Svg Path="/Assets/Icons/catalog.svg" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <TextBlock Text="{Binding Product.Name}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CreatedAtUtc, StringFormat='Предзаказ №{0} · dd.MM.yyyy HH:mm'}" FontSize="10" Foreground="{DynamicResource C_778279}" />
                          </StackPanel>
                          <Border Grid.Column="2" Background="{DynamicResource C_EDF2EC}" CornerRadius="7" Padding="9,6" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusDisplayName}" FontSize="10" Foreground="{DynamicResource C_526C59}" />
                          </Border>
                          <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{Binding Quantity, StringFormat='{}{0} шт.'}" FontSize="10" Foreground="{DynamicResource C_778279}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding TotalDisplay}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding PaymentDisplay}" FontSize="9" Foreground="{DynamicResource C_66736A}" HorizontalAlignment="Right"/>
                          </StackPanel>
                          <Button Grid.Column="4" Classes="secondary" Content="Отменить" Tag="{Binding}" Click="OnCancelOrderClick" IsVisible="{Binding CanCancel}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel IsVisible="{Binding HasNoOrders}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="11">
                <svg:Svg Path="/Assets/Icons/receipt.svg" Width="40" Height="40" HorizontalAlignment="Center" />
                <TextBlock Text="Заказов пока нет" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Покупки из вашего аккаунта появятся здесь." FontSize="11" Foreground="{DynamicResource C_778279}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>

          <Grid IsVisible="{Binding IsProductDetailsVisible}" Classes="page-content" Classes.page-entering="{Binding IsPageEntering}" ColumnDefinitions="1.05*,*" ColumnSpacing="20">
            <Border Grid.Column="0" Classes="surface detail-hero" Padding="20" Background="{DynamicResource C_E9EDE8}">
              <Grid RowDefinitions="*,Auto" RowSpacing="12">
                <Grid>
                  <Border Background="{DynamicResource C_F2F4F0}" CornerRadius="13" ClipToBounds="True">
                    <Grid>
                      <svg:Svg Path="/Assets/Icons/catalog.svg" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !SelectedProduct.IsLocalProduct}" />
                      <svg:Svg Path="{Binding SelectedProduct.ImageAssetPath}" Stretch="Uniform" Margin="52" IsVisible="{Binding SelectedProduct.IsLocalProduct}" />
                      <views:RemoteImage Url="{Binding SelectedImageUrl}" Stretch="UniformToFill" IsVisible="{Binding HasSelectedImage}" />
                    </Grid>
                  </Border>
                  <Border Classes="release-badge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
                    <TextBlock Text="{Binding SelectedProduct.ReleaseStateDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource C_365C43}" />
                  </Border>
                  <Button Classes="secondary" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Command="{Binding BackFromProductCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7"><svg:Svg Path="/Assets/Icons/arrow-left.svg" Width="16" Height="16"/><TextBlock Text="Назад в каталог" FontSize="11"/></StackPanel>
                  </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasAdditionalProductImages}">
                  <ItemsControl ItemsSource="{Binding ProductImageUrls}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="9" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="secondary" Padding="2" Tag="{Binding}" Click="OnSelectProductImageClick">
                          <Border Width="86" Height="66" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource C_F2F4F0}">
                            <views:RemoteImage Url="{Binding}" Stretch="UniformToFill" />
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="16" Margin="7,6,4,4">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding SelectedProduct.CategoryDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource C_54715E}" LetterSpacing="1" />
                <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="28" FontWeight="SemiBold" LetterSpacing="-0.5" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedPriceText}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource C_234B37}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding SelectedRatingSummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource C_695A3D}" />
                <TextBlock Text="локальная позиция каталога" FontSize="10" Foreground="{DynamicResource C_778279}" IsVisible="{Binding IsLocalProductSelected}" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="15">
                  <Border Background="{DynamicResource C_FFFFFF}" BorderBrush="{DynamicResource C_E1E6E0}" BorderThickness="1" CornerRadius="11" Padding="14">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                      <svg:Svg Path="/Assets/Icons/info.svg" Width="18" Height="18" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="О товаре" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedProduct.Description}" FontSize="11.5" Foreground="{DynamicResource C_66736A}" TextWrapping="Wrap" LineHeight="17" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                    <Border Background="{DynamicResource C_E4EFE7}" CornerRadius="9" Padding="11,8"><TextBlock Text="{Binding SelectedAvailabilityText}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource C_365C43}" /></Border>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedArrivalText}" FontSize="10.5" Foreground="{DynamicResource C_778279}" VerticalAlignment="Center" />
                  </Grid>
                  <Border Background="{DynamicResource C_F5F3ED}" BorderBrush="{DynamicResource C_E9E4D9}" BorderThickness="1" CornerRadius="9" Padding="12">
                    <TextBlock Text="Цена и наличие указаны для ориентира; подтвердите их перед оформлением." FontSize="10" Foreground="{DynamicResource C_716958}" TextWrapping="Wrap" />
                  </Border>
                  <Border Background="{DynamicResource C_FFFFFF}" BorderBrush="{DynamicResource C_E1E6E0}" BorderThickness="1" CornerRadius="11" Padding="14">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Отзывы покупателей" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedRatingSummaryText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource C_695A3D}" VerticalAlignment="Center" />
                      </Grid>
                  <TextBlock Text="Отзывы приведены как примеры и не являются отзывами покупателей магазина." FontSize="9" Foreground="{DynamicResource C_778279}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ReviewsStatusText}" IsVisible="{Binding !HasProductReviews}" FontSize="10" Foreground="{DynamicResource C_778279}" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding ProductReviews}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{DynamicResource C_F7F9F6}" CornerRadius="9" Padding="11" Margin="0,0,0,7">
                              <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock Text="{Binding ReviewerName}" FontSize="10.5" FontWeight="SemiBold" />
                                  <TextBlock Grid.Column="1" Text="{Binding DateDisplay}" FontSize="9" Foreground="{DynamicResource C_778279}" />
                                </Grid>
                                <TextBlock Text="{Binding RatingStars}" FontSize="11" Foreground="{DynamicResource C_695A3D}" />
                                <TextBlock Text="{Binding Comment}" FontSize="10" Foreground="{DynamicResource C_66736A}" TextWrapping="Wrap" LineHeight="15" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <Button Classes="primary" Content="Добавить в корзину" Tag="{Binding SelectedProduct}" Click="OnAddToCartClick" IsEnabled="{Binding SelectedProduct.IsAvailable}" HorizontalContentAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedProduct.CartQuantity, StringFormat='{}{0} в корзине'}" IsVisible="{Binding IsSelectedProductInCart}" FontSize="10" Foreground="{DynamicResource C_526C59}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="icon-button" IsVisible="{Binding IsSelectedProductInCart}" Tag="{Binding SelectedProduct}" Click="OnRemoveProductFromCartClick" ToolTip.Tip="Убрать один товар из корзины">
                  <svg:Svg Path="/Assets/Icons/minus.svg" Width="16" Height="16" />
                </Button>
                <Button Grid.Column="4" Classes="favorite-action" Classes.liked="{Binding SelectedProduct.IsFavorite}" Tag="{Binding SelectedProduct}" Click="OnToggleFavoriteClick" ToolTip.Tip="{Binding SelectedProduct.FavoriteButtonLabel}">
                  <svg:Svg Path="{Binding SelectedProduct.FavoriteIconPath}" Width="20" Height="20" />
                </Button>
                <Button Grid.Column="3" Classes="secondary" IsVisible="{Binding IsLocalProductSelected}" Command="{Binding DeleteLocalProductCommand}" ToolTip.Tip="Удалить локальный товар" Padding="11,9">
                  <StackPanel Orientation="Horizontal" Spacing="6"><svg:Svg Path="/Assets/Icons/trash.svg" Width="16" Height="16" /><TextBlock Text="Удалить" FontSize="11" /></StackPanel>
                </Button>
              </Grid>
            </Grid>
          </Grid>

          <Grid IsVisible="{Binding IsManageProductVisible}" Classes="page-content" Classes.page-entering="{Binding IsPageEntering}" ColumnDefinitions="*,400" ColumnSpacing="20">
            <Border Classes="surface" Padding="23">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" MaxWidth="670" HorizontalAlignment="Left">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Новая позиция" FontSize="21" FontWeight="SemiBold" LetterSpacing="-0.3" />
                    <TextBlock Text="Новая позиция сохранится в каталоге отдельно от существующих товаров." FontSize="11" Foreground="{DynamicResource C_778279}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="6"><TextBlock Classes="form-label" Text="Название"/><TextBox Text="{Binding NewProductName}" PlaceholderText="Например, Беспроводные наушники"/></StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6"><TextBlock Classes="form-label" Text="Категория"/><TextBox Text="{Binding NewProductCategory}" PlaceholderText="audio, smartphones…"/></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Classes="form-label" Text="Иллюстрация"/><ComboBox ItemsSource="{Binding ProductIllustrationOptions}" SelectedItem="{Binding SelectedProductIllustration}"/></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6"><TextBlock Classes="form-label" Text="Цена, ₽"/><TextBox Text="{Binding NewProductPrice}" PlaceholderText="12990"/></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Classes="form-label" Text="Количество"/><TextBox Text="{Binding NewProductStock}" PlaceholderText="5"/></StackPanel>
                  </Grid>
                  <StackPanel Spacing="6"><TextBlock Classes="form-label" Text="Описание"/><TextBox Text="{Binding NewProductDescription}" PlaceholderText="Кратко расскажите о товаре" AcceptsReturn="True" MinHeight="92" TextWrapping="Wrap"/></StackPanel>
                  <StackPanel Spacing="6"><TextBlock Classes="form-label" Text="Ссылка на изображение · необязательно"/><TextBox Text="{Binding NewProductImageUrl}" PlaceholderText="https://… (пусто — выберите иллюстрацию)"/></StackPanel>
                  <Button Classes="primary" Content="Сохранить в каталог" Command="{Binding CreateLocalProductCommand}" IsEnabled="{Binding !IsBusy}" HorizontalContentAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
              </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Classes="surface" Background="{DynamicResource C_E9EDE8}" Padding="20">
              <StackPanel VerticalAlignment="Center" Spacing="12">
                <Border Background="{DynamicResource C_F2F4F0}" CornerRadius="14" Height="230" Padding="30">
                  <svg:Svg Path="{Binding SelectedProductIllustrationPath}" Stretch="Uniform" />
                </Border>
                <TextBlock Text="Ваш локальный ассортимент" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Удаление доступно для созданных здесь позиций, если они ещё не участвуют в корзине или истории покупок." FontSize="11" Foreground="{DynamicResource C_6D786F}" TextWrapping="Wrap" LineHeight="16" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource C_ECEFEA}" Padding="32,8" BorderBrush="{DynamicResource C_DCE2DC}" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Notice}" FontSize="10.5" Foreground="{DynamicResource C_66736A}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding LastSyncText}" FontSize="9.5" Foreground="{DynamicResource C_859086}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Login and local registration -->
    <Grid IsVisible="{Binding IsAuthVisible}" Background="{DynamicResource C_F4F5F1}">
      <Border Classes="surface" Padding="30" Margin="24" Width="450" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="АККАУНТ ДЛЯ ОФОРМЛЕНИЯ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource C_6F7E72}" LetterSpacing="1.1" />
          <TextBlock Text="{Binding AuthTitle}" FontSize="24" FontWeight="SemiBold" LetterSpacing="-0.35" />
          <TextBlock Text="Для покупки войдите или создайте аккаунт. Каталог и корзина доступны без регистрации." FontSize="11" Foreground="{DynamicResource C_748077}" TextWrapping="Wrap" Margin="0,0,0,5" />

          <StackPanel IsVisible="{Binding IsRegisterPanel}" Spacing="6">
            <TextBlock Classes="form-label" Text="Имя" />
            <TextBox Text="{Binding DisplayName}" PlaceholderText="Как к вам обращаться" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="form-label" Text="Электронная почта" />
            <TextBox Text="{Binding Email}" PlaceholderText="name@example.com" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Classes="form-label" Text="Пароль" />
            <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="Не менее 8 символов" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsRegisterPanel}" Spacing="6">
            <TextBlock Classes="form-label" Text="Повторите пароль" />
            <TextBox Text="{Binding PasswordConfirmation}" PasswordChar="●" PlaceholderText="Повторите пароль" />
          </StackPanel>
          <TextBlock Classes="muted" Text="Для аккаунта нужен пароль от 8 символов." FontSize="9.5" IsVisible="{Binding IsRegisterPanel}" />

          <Button Classes="primary" IsVisible="{Binding IsSignInPanel}" Command="{Binding SignInCommand}" Content="Войти" HorizontalContentAlignment="Center" Margin="0,7,0,0" />
          <Button Classes="primary" IsVisible="{Binding IsRegisterPanel}" Command="{Binding RegisterCommand}" Content="Создать аккаунт" HorizontalContentAlignment="Center" Margin="0,7,0,0" />
          <Button Classes="link" Content="{Binding AuthSwitchText}" Command="{Binding ToggleAuthModeCommand}" HorizontalAlignment="Center" />
          <Button Classes="secondary" Content="Пропустить регистрацию · продолжить гостем" Command="{Binding SkipRegistrationCommand}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Notice}" Classes="notice-error" IsVisible="{Binding HasNotice}" FontSize="10.5" TextWrapping="Wrap" />
          <Border Background="{DynamicResource C_F5F3ED}" BorderBrush="{DynamicResource C_E9E4D9}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="7">
              <svg:Svg Path="/Assets/Icons/info.svg" Width="15" Height="15" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Text="Пароль хранится в локальном виде с солью и хэшированием. Подтверждение почты и синхронизация между устройствами не настроены." FontSize="9" Foreground="{DynamicResource C_716958}" TextWrapping="Wrap" LineHeight="14" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
    <Canvas x:Name="FlyOverlay" IsVisible="{Binding IsAppVisible}" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="False" />
  </Grid>
</Window>
